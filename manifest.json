{
  "manifest_version": 3,
  "name": "Zoomaid",
  "version": "0.1.0",
  "description": "ページ中の Mermaid 図を、拡大・移動しながら快適に読む。",
  "icons": {
    "16": "extension/icon-16.png",
    "32": "extension/icon-32.png",
    "48": "extension/icon-48.png",
    "128": "extension/icon-128.png"
  },
  "action": {
    "default_title": "Zoomaid を開く（クリップボードを貼り付け）"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*",
        "https://gitlab.com/*",
        "https://*.backlog.com/*",
        "https://*.backlog.jp/*"
      ],
      "js": ["extension/content.js"],
      "run_at": "document_idle"
    }
  ]
}
